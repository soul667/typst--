@inproceedings{wangOneStepDiffusionPolicy2025,
  title = {One-{{Step Diffusion Policy}}: {{Fast Visuomotor Policies}} via {{Diffusion Distillation}}},
  shorttitle = {One-{{Step Diffusion Policy}}},
  booktitle = {Proceedings of the {{International Conference}} on {{Machine Learning}} ({{ICML}})},
  author = {Wang, Zhendong and Li, Max and Mandlekar, Ajay and Xu, Zhenjia and Fan, Jiaojiao and Narang, Yashraj and Fan, Linxi and Zhu, Yuke and Balaji, Yogesh and Zhou, Mingyuan and Liu, Ming-Yu and Zeng, Yu},
  year = 2025,
  month = jun,
  series = {{{ICML2025}}},
  urldate = {2025-11-27},
  abstract = {扩散模型因其在生成任务中的出色表现而备受赞誉，正越来越多地应用于机器人领域，在行为克隆任务中展现出卓越性能。然而，其迭代去噪步骤导致的生成过程缓慢，对资源受限的机器人系统和动态变化环境中的实时应用构成了挑战。本文提出了一种名为单步扩散策略（OneDP）的新方法，该方法将预训练扩散策略中的知识蒸馏到一个单步动作生成器中，显著加快了机器人控制任务的响应速度。我们通过沿扩散链最小化Kullback-Leibler（KL）散度，确保蒸馏后的生成器与原始策略分布高度一致，且仅需额外2\%--10\%的预训练成本即可收敛。我们在6个具有挑战性的仿真任务以及使用Franka机器人完成的4个自主设计的真实世界任务上对OneDP进行了评估。结果表明，OneDP不仅取得了最先进的成功率，还将推理速度提升了一个数量级，将动作预测频率从1.5 Hz提高到62 Hz，展现出其在动态和计算资源受限的机器人应用中的巨大潜力。视频演示见项目主页，代码将公开发布。 Progressive Distillation (渐进式蒸馏)。 逻辑： 先训练一个``慢但是强''的教师模型（Teacher, 标准的 Diffusion Policy，推理要 100 步）。 再训练一个``快但是嫩''的学生模型（Student）。 让学生去模仿老师 N 步的输出，强行把 100 步压缩到 10 步，再压缩到 1 步。 为什么中了 RSS？ RSS 极其看重实机效果。这篇论文不仅把推理速度提到了 100Hz 以上，而且在真机实验上证明了``虽然我只推理一步，但我动作依然丝滑，不像 Consistency Model 那么容易抖''。},
  langid = {english},
  keywords = {/},
  annotation = {titleTranslation: 一步扩散策略：基于扩散蒸馏的快速视觉运动策略},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\9MF7Y7C3\\Wang 等 - 2025 - One-Step Diffusion Policy Fast Visuomotor Policies via Diffusion Distillation.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\HMVW7KUE\\Wang 等 - One-Step Diffusion Policy Fast Visuomotor Policies via Diffusion....zh.mono.pdf}
}

