@misc{yanManiFlowGeneralRobot2025,
  title = {{{ManiFlow}}: {{A General Robot Manipulation Policy}} via {{Consistency Flow Training}}},
  shorttitle = {{{ManiFlow}}},
  author = {Yan, Ge and Zhu, Jiyue and Deng, Yuquan and Yang, Shiqi and Qiu, Ri-Zhao and Cheng, Xuxin and Memmel, Marius and Krishna, Ranjay and Goyal, Ankit and Wang, Xiaolong and Fox, Dieter},
  year = 2025,
  month = sep,
  number = {arXiv:2509.01819},
  eprint = {2509.01819},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2509.01819},
  urldate = {2025-12-01},
  abstract = {本文提出 ManiFlow，一种用于通用机器人操作的视觉运动模仿学习策略，能够基于多样化的视觉、语言和本体感知输入生成精确的高维动作。我们结合流匹配与一致性训练，仅需 1-2 步推理即可实现高质量的灵巧动作生成。为高效处理多模态输入，我们提出了 DiT-X 架构------一种扩散 Transformer，其采用自适应交叉注意力机制与 AdaLN-Zero 条件化方法，实现动作 token 与多模态观测之间的细粒度特征交互。ManiFlow 在多种仿真基准测试中均表现出持续提升，并在真实世界任务中，针对单臂、双臂及人形机器人等不同灵巧度配置，几乎将成功率提高了一倍。大量实验进一步验证了 ManiFlow 对新物体和背景变化的强大鲁棒性与泛化能力，并凸显其在更大规模数据集上的优异扩展性能。项目网站：maniflow-policy.github.io。},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {/},
  annotation = {TLDR: This paper introduces ManiFlow, a visuomotor imitation learning policy for general robot manipulation that generates precise, high-dimensional actions conditioned on diverse visual, language and proprioceptive inputs and proposes DiT-X, a diffusion transformer architecture with adaptive cross-attention and AdaLN-Zero conditioning that enables fine-grained feature interactions between action tokens and multi-modal observations.\\
titleTranslation: ManiFlow：基于一致性流训练的通用机器人操作策略},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\7HWYGUHN\\Yan 等 - 2025 - ManiFlow A General Robot Manipulation Policy via Consistency Flow Training.no_watermark.zh-CN.mono.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\A3XB4YLX\\Yan 等 - 2025 - ManiFlow A General Robot Manipulation Policy via Consistency Flow Training.pdf}
}

