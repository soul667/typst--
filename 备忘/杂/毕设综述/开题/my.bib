  abstract = {从大规模多任务演示数据集中进行模仿学习已成为构建通用机器人的一条有前景的路径。因此，全球已投入数千小时用于构建此类大规模数据集。尽管相关工作持续增长，我们仍缺乏对``应收集何种数据以提升机器人数据集效用并促进下游策略学习''这一问题的系统性理解。在本研究中，我们开展了一项大规模数据集构成研究以回答该问题。我们开发了一个数据生成框架，以程序化方式模拟现有数据集中常见的多样性来源（如传感器位置、物体类型及布局），并利用该框架生成具有可控构成的大规模机器人数据集，从而实现一系列在现实世界中成本过高而难以开展的数据集构成研究。我们聚焦于两个实际场景：（1）未来研究者在为机器人学收集大规模数据集时应强调哪些类型的多样性；（2）当前从业者应如何从现有数据集中检索相关演示，以最大化目标任务的下游策略性能。我们的研究得出了若干关键见解------例如，我们发现相机位姿和空间布局对于数据收集中的多样性以及数据检索中的对齐都至关重要。在真实世界的机器人学习场景中，我们不仅验证了仿真所得见解的有效性，还发现基于现有数据集（如DROID）应用我们的检索策略，可始终优于现有训练策略，性能提升最高达70\%。更多结果请见：https://robo-mimiclabs.github.io/},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {/unread},
  annotation = {TLDR: This work develops a data generation framework to procedurally emulate common sources of diversity in existing datasets, and uses it to generate large-scale robot datasets with controlled compositions, enabling a suite of dataset composition studies that would be prohibitively expensive in the real world.\\
titleTranslation: 面向机器人操作的大规模数据集学习中的关键因素},
  file = {C:\Users\guaoxiang\Zotero\storage\FGLMEKDN\2506.html}
}

@misc{saxenaWhatMattersLearning2025a,
  title = {What {{Matters}} in {{Learning}} from {{Large-Scale Datasets}} for {{Robot Manipulation}}},
  author = {Saxena, Vaibhav and Bronars, Matthew and Arachchige, Nadun Ranawaka and Wang, Kuancheng and Shin, Woo Chul and Nasiriany, Soroush and Mandlekar, Ajay and Xu, Danfei},
  year = 2025,
  month = jun,
  eprint = {2506.13536},
  primaryclass = {cs},
  doi = {10.48550/arXiv.2506.13536},
  urldate = {2026-01-22},
  abstract = {Imitation learning from large multi-task demonstration datasets has emerged as a promising path for building generally-capable robots. As a result, 1000s of hours have been spent on building such large-scale datasets around the globe. Despite the continuous growth of such efforts, we still lack a systematic understanding of what data should be collected to improve the utility of a robotics dataset and facilitate downstream policy learning. In this work, we conduct a large-scale dataset composition study to answer this question. We develop a data generation framework to procedurally emulate common sources of diversity in existing datasets (such as sensor placements and object types and arrangements), and use it to generate large-scale robot datasets with controlled compositions, enabling a suite of dataset composition studies that would be prohibitively expensive in the real world. We focus on two practical settings: (1) what types of diversity should be emphasized when future researchers collect large-scale datasets for robotics, and (2) how should current practitioners retrieve relevant demonstrations from existing datasets to maximize downstream policy performance on tasks of interest. Our study yields several critical insights -- for example, we find that camera poses and spatial arrangements are crucial dimensions for both diversity in collection and alignment in retrieval. In real-world robot learning settings, we find that not only do our insights from simulation carry over, but our retrieval strategies on existing datasets such as DROID allow us to consistently outperform existing training strategies by up to 70\%. More results at https://robo-mimiclabs.github.io/},
  archiveprefix = {arXiv},
  howpublished = {http://arxiv.org/abs/2506.13536},
  langid = {american},
  pubstate = {prepublished},
  keywords = {/unread},
  file = {C:\Users\guaoxiang\Zotero\storage\ED7EXNX7\2506.html}
}

@misc{shiDiversityAllYou2025,
  title = {Is {{Diversity All You Need}} for {{Scalable Robotic Manipulation}}?},
  author = {Shi, Modi and Chen, Li and Chen, Jin and Lu, Yuxiang and Liu, Chiming and Ren, Guanghui and Luo, Ping and Huang, Di and Yao, Maoqing and Li, Hongyang},
  year = 2025,
  month = jul,
  number = {arXiv:2507.06219},
  eprint = {2507.06219},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2507.06219},
  urldate = {2025-09-16},
  abstract = {数据规模的扩大推动了自然语言处理（NLP）和计算机视觉（CV）领域基础模型的显著成功，然而在机器人操作任务中，有效数据扩展的原则仍缺乏充分理解。本文通过考察三个关键维度------任务（做什么）、本体（使用哪种机器人）和专家（由谁演示）------深入探究了数据多样性在机器人学习中的复杂作用，挑战了``越多样越好''的传统直觉。在多种机器人平台上进行的大量实验表明：（1）任务多样性比单个任务的演示数量更为关键，有助于将多样化的预训练任务迁移到新颖的下游场景；（2）跨本体迁移并不一定需要多本体预训练数据------基于高质量单一本体数据训练的模型能够高效迁移到不同平台，并在微调过程中展现出比多本体预训练模型更优的扩展特性；（3）专家多样性（源于人类演示者个体操作偏好及随机变化）可能对策略学习产生干扰，其中速度的多模态性是关键诱因。基于这一发现，我们提出一种分布去偏方法以缓解速度模糊性，所得到的GO-1-Pro模型性能提升达15\%，相当于使用了2.5倍的预训练数据量。这些发现共同为如何高效扩展机器人操作数据集提供了新的视角与实用指导。 同组的 AgiBot World 作者团队： OpenDriveLab (香港大学/上海AI Lab 背景，李弘扬团队), AgiBot (智元机器人) 等 结论 1 (打脸 Open-X)： Multi-embodiment data is optional (跨具身数据是可有可无的)。 解读： 这一点非常炸裂。主流观点认为要把 Franka、UR5、Kuka 的数据混在一起训才能由 A 泛化到 B。但这篇论文实验发现，只要你的**任务（Task）**足够多样，哪怕只用一种机器人训，泛化性也够了。强行引入不同构型的机器人数据，反而会引入``速度模糊 (Velocity Ambiguity)''和分布偏移，导致效果下降。 结论 2： Task Diversity {$>$} Scene Diversity。 解读： 想要机器人聪明，教它做更多种类的事（开瓶盖、叠衣服、倒水），比教它在更多种桌子/灯光下做同一件事（Pick \& Place）要重要得多。 结论 3： Expert Quality (专家质量) 很重要。 解读： 这一点比较常规，但它量化了``烂数据''的破坏力。},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {/,notion},
  annotation = {TLDR: This work investigates the nuanced role of data diversity in robot learning by examining three critical dimensions-task, embodiment, and expert (who demonstrates)-challenging the conventional intuition of"more diverse is better".\\
titleTranslation: 多样性是否足以实现可扩展的机器人操作？},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\BLDS2YFW\\Shi et al. - 2025 - Is Diversity All You Need for Scalable Robotic Man.no_watermark.zh-CN.mono.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\QIX2ZX5Q\\Shi et al. - 2025 - Is Diversity All You Need for Scalable Robotic Man.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\WR77WWNZ\\Shi et al. - 2025 - Is Diversity All You Need for Scalable Robotic Man.html}
}

