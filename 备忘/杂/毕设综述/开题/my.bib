@article{liHowTrainYour2025,
  title = {How to {{Train Your Robots}}? {{The Impact}} of {{Demonstration Modality}} on {{Imitation Learning}}},
  shorttitle = {How to {{Train Your Robots}}?},
  author = {Li, Haozhuo and Cui, Yuchen and Sadigh, Dorsa},
  year = 2025,
  journal = {2025 IEEE International Conference on Robotics and Automation (ICRA)},
  series = {{{ICRA2025}}},
  eprint = {2503.07017},
  primaryclass = {cs},
  pages = {1113--1120},
  doi = {10.48550/arXiv.2503.07017},
  urldate = {2025-12-01},
  abstract = {模仿学习是一种利用用户提供的数据来学习机器人策略的有前景方法。示范提供的方式（即示范模态）会影响数据质量。尽管现有研究表明，动觉教学（即通过物理引导机器人）因其直观性和易用性而更受用户青睐，但目前大多数操作类数据集仍是通过虚拟现实（VR）控制器或SpaceMouse进行遥操作采集的。本文研究了不同示范模态对下游学习性能及用户体验的影响。具体而言，我们比较了几种低成本的示范模态，包括动觉教学、基于VR控制器的遥操作以及基于SpaceMouse控制器的遥操作。我们在三个具有不同运动约束的桌面操作任务上进行了实验，评估并对比了来自不同示范模态的数据在模仿学习中的性能表现，同时收集了用户关于体验的主观反馈。结果表明，动觉教学在控制机器人方面被认为最直观，并能提供最干净的数据，从而实现最优的下游学习性能；然而，由于其带来的体力负担，该方法并不适合作为大规模数据采集的手段。基于这一发现，我们提出了一种简单的数据采集方案：将少量动觉示范与遥操作采集的数据混合使用，在保持较低数据采集成本的同时，实现最佳的整体学习性能。 生态位： Data-Centric Robot Learning / Human-Robot Interaction。 现在大家都在疯狂复现 ALOHA (Teleoperation)，觉得遥操作就是终极答案。这篇论文跳出来说：``慢着，遥操作的数据其实很脏。'' 它对比了三种采集数据的方式： Kinesthetic Teaching (手把手示教)： 你抓着机器人的手去动（拖拽示教）。 Teleoperation (遥操作)： 用 VR 手柄或者 SpaceMouse 控制。 Passive Observation (被动观测)： 也就是看人类视频（Video）。 核心暴论（结论）： Kinesthetic {$>$} Teleop (质量上)： 手把手示教的数据质量（Cleanliness）和下游模型的成功率，显著高于遥操作。 原因： 遥操作（Teleop）总是存在延时、深度感知误差和手抖，导致采集的数据含噪量高。而 Kinesthetic 是直接接触，轨迹最顺滑，最符合机器人的运动学。 Teleop {$>$} Kinesthetic (体验上)： 大家都喜欢遥操作，因为手把手拖机器人太累了（Physical Load），而且大机器人你根本拖不动。 Golden Ratio (黄金配方)： 既然 Kinesthetic 质量高但累人，Teleop 质量一般但轻松。论文提出了一个 Hybrid Strategy： 少量 Kinesthetic 数据 (作为高质量 Seed) + 大量 Teleop 数据 = SOTA。 这直接呼应了你刚才看的``Expert Quality''理论------你需要那一小撮最顶级的``金子数据''来锚定策略的上限。},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {/,notion},
  annotation = {GSCC: 0000007 2025-12-03T03:28:20.837Z 0.14 \\
titleTranslation: 如何训练你的机器人？示范模态对模仿学习的影响\\
