@inproceedings{zhangGAMMAGraspabilityAwareMobile2024,
  title = {{\textbraceleft GAMMA:\textbraceright{} Graspability-Aware Mobile MAnipulation Policy Learning based on Online Grasping Pose Fusion}},
  shorttitle = {{GAMMA}},
  booktitle = {{Proceedings of the IEEE International Conference on Robotics and Automation}},
  author = {Zhang, Jiazhao and Gireesh, Nandiraju and Wang, Jilong and Fang, Xiaomeng and Xu, Chaoyi and Chen, Weiguang and Dai, Liu and Wang, He},
  year = 2024,
  eprint = {2309.15459},
  primaryclass = {cs},
  pages = {1399--1405},
  publisher = {\textbraceleft IEEE\textbraceright},
  doi = {10.1109/ICRA57147.2024.10610125},
  urldate = {2024-09-25},
  abstract = {Mobile manipulation constitutes a fundamental task for robotic assistants and garners significant attention within the robotics community. A critical challenge inherent in mobile manipulation is the effective observation of the target while approaching it for grasping. In this work, we propose a graspability-aware mobile manipulation approach powered by an online grasping pose fusion framework that enables a temporally consistent grasping observation. Specifically, the predicted grasping poses are online organized to eliminate the redundant, outlier grasping poses, which can be encoded as a grasping pose observation state for reinforcement learning. Moreover, on-the-fly fusing the grasping poses enables a direct assessment of graspability, encompassing both the quantity and quality of grasping poses. GAMMA 的贡献： 它把``抓取的可达性 (Graspability)''融合到了底盘的导航策略里。简单说，就是**``看着手（能不能抓到）来走位''**，而不是瞎走到目的地再伸手。它不是 End-to-End 的大黑盒，而是 RL Policy (用于导航) + Grasp Pose Generator (用于抓取) 的混合体。},
  archiveprefix = {arXiv},
  langid = {chinese},
  keywords = {/,Mobile Manipulation},
  annotation = {titleTranslation: GAMMA：基于在线抓取姿态融合的可抓取性感知移动操作策略学习\\
TLDR: This work proposes a graspability-aware mobile manipulation approach powered by an online grasping pose fusion framework that enables a temporally consistent grasping observation, and discovers that the incorporation of temporal information from grasping poses aids in mitigating the sim-to-real gap, leading to robust performance in challenging real-world experiments.},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\LQWSWFIX\\Zhang 等 - 2024 - GAMMA Graspability-Aware Mobile MAnipulation Policy Learning based on Online Grasping Pose Fusion.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\9DUDT2VI\\2309.html}
}

