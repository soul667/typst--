@inproceedings{jiangDexMimicGenAutomatedData2025,
  title = {{{DexMimicGen}}: {{Automated Data Generation}} for {{Bimanual Dexterous Manipulation}} via {{Imitation Learning}}},
  shorttitle = {{{DexMimicGen}}},
  booktitle = {Proceedings of the {{IEEE International Conference}} on {{Robotics}} and {{Automation}}},
  author = {Jiang, Zhenyu and Xie, Yuqi and Lin, Kevin and Xu, Zhenjia and Wan, Weikang and Mandlekar, Ajay and Fan, Linxi Jim and Zhu, Yuke},
  year = 2025,
  eprint = {2410.24185},
  primaryclass = {cs},
  pages = {16923--16930},
  publisher = {IEEE},
  doi = {10.1109/ICRA55743.2025.11127809},
  urldate = {2026-01-28},
  abstract = {Imitation learning from human demonstrations is an effective means to teach robots manipulation skills. But data acquisition is a major bottleneck in applying this paradigm more broadly, due to the amount of cost and human effort involved. There has been significant interest in imitation learning for bimanual dexterous robots, like humanoids. Unfortunately, data collection is even more challenging here due to the challenges of simultaneously controlling multiple arms and multi-fingered hands. Automated data generation in simulation is a compelling, scalable alternative to fuel this need for data. To this end, we introduce DexMimicGen, a large-scale automated data generation system that synthesizes trajectories from a handful of human demonstrations for humanoid robots with dexterous hands. We present a collection of simulation environments in the setting of bimanual dexterous manipulation, spanning a range of manipulation behaviors and different requirements for coordination among the two arms. We generate 21K demos across these tasks from just 60 source human demos and study the effect of several data generation and policy learning decisions on agent performance. Finally, we present a real-to-sim-to-real pipeline and deploy it on a real-world humanoid can sorting task. Generated datasets, simulation environments and additional results are at https://dexmimicgen.github.io/},
  archiveprefix = {arXiv},
  langid = {american},
  annotation = {abstractTranslation: 通过人类示范进行的模仿学习是教授机器人操作技能的一种有效方法。然而，由于所需的成本和人力投入较大，数据采集成为该范式更广泛应用的主要瓶颈。近年来，针对类人机器人等具备双臂灵巧操作能力的系统，模仿学习引起了广泛关注。遗憾的是，在这类系统中，数据采集更具挑战性，因为需要同时控制多条机械臂和多指灵巧手。在仿真环境中自动生成数据是一种极具吸引力且可扩展的替代方案，能够有效满足对大规模训练数据的需求。为此，我们提出了DexMimicGen------一个面向配备灵巧手的类人机器人的大规模自动化数据生成系统，该系统仅需少量人类示范即可合成大量轨迹数据。我们构建了一系列双臂灵巧操作的仿真环境，涵盖多种操作行为以及对双臂协调性的不同要求。基于仅60个原始人类示范，我们在这些任务中生成了21,000个演示，并系统研究了若干数据生成与策略学习设计选择对智能体性能的影响。最后，我们提出了一种``真实{$\rightarrow$}仿真{$\rightarrow$}真实''（real-to-sim-to-real）的迁移流程，并将其部署于真实世界的类人机器人罐体分拣任务中。所生成的数据集、仿真环境及更多实验结果详见：https://dexmimicgen.github.io/},
  file = {C:\Users\guaoxiang\Zotero\storage\TQQE4AU4\Jiang 等 - 2025 - DexMimicGen Automated Data Generation for Bimanual Dexterous Manipulation via Imitation Learning.pdf}
}

@inproceedings{jiangEnerVerseACEnvisioningEmbodied2025,
  title = {{EnerVerse-AC: Envisioning Embodied Environments with Action Condition}},
  shorttitle = {{EnerVerse-AC}},
  booktitle = {{NeurIPS 2025 Workshop on Embodied World Models for Decision Making}},
  author = {Jiang, Yuxin and Chen, Shengcong and Huang, Siyuan and Chen, Liliang and Zhou, Pengfei and Liao, Yue and He, Xindong and Liu, Chiming and Li, Hongsheng and Yao, Maoqing and Ren, Guanghui},
  year = 2025,
  month = sep,
  urldate = {2026-01-22},
  abstract = {Robotic imitation learning has advanced from solving static tasks to addressing dynamic interaction scenarios, but testing and evaluation remain costly and challenging due to the need for real-time interaction with dynamic environments. We propose EnerVerse-AC(abbr. EVAC), an action-conditional world model that generates future visual observations based on an agent's predicted actions, enabling realistic and controllable robotic inference. Building on prior architectures, EVAC introduces a multi-level action-conditioning mechanism and ray map encoding for dynamic multi-view image generation while expanding training data with diverse failure trajectories to improve generalization. As both a data engine and evaluator, EVAC augments human-collected trajectories into diverse datasets and generates realistic, action-conditioned video observations for policy testing, eliminating the need for physical robots or complex simulations. This approach significantly reduces costs while maintaining high fidelity in robotic manipulation evaluation. Extensive experiments validate the effectiveness of our method.},
  langid = {chinese},
  keywords = {/unread,notion},
  file = {C:\Users\guaoxiang\Zotero\storage\397Y2JXE\Jiang 等 - 2025 - EnerVerse-AC Envisioning Embodied Environments with Action Condition.pdf}
}

