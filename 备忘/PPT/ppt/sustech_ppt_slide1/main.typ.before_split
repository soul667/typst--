    [月 3-4], [双臂解耦引擎 + TAMP 集成],
    [月 4-5], [5+1 轴域随机化 + 50K 轨迹生成 + Scaling Law 验证],
    [月 5-6], [真实部署评估 + 论文撰写],
  )
]

