  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\2JV675UK\\Li 等 - 2025 - How to Train Your Robots The Impact of Demonstration Modality on Imitation Learning.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\J4H7V25R\\Li 等 - 2025 - How to Train Your Robots The Impact of Demonstration Modality on Imitation Learning.no_watermark.zh-CN.mono.pdf}
