@misc{chenImplicitRDPEndtoEndVisualForce2025a,
  title = {{{ImplicitRDP}}: {{An End-to-End Visual-Force Diffusion Policy}} with {{Structural Slow-Fast Learning}}},
  shorttitle = {{{ImplicitRDP}}},
  author = {Chen, Wendi and Xue, Han and Wang, Yi and Zhou, Fangyuan and Lv, Jun and Jin, Yang and Tang, Shirun and Wen, Chuan and Lu, Cewu},
  year = 2025,
  month = dec,
  eprint = {2512.10946},
  primaryclass = {cs},
  doi = {10.48550/arXiv.2512.10946},
  urldate = {2025-12-18},
  abstract = {Human-level contact-rich manipulation relies on the distinct roles of two key modalities: vision provides spatially rich but temporally slow global context, while force sensing captures rapid, high-frequency local contact dynamics. Integrating these signals is challenging due to their fundamental frequency and informational disparities. In this work, we propose ImplicitRDP, a unified end-to-end visual-force diffusion policy that integrates visual planning and reactive force control within a single network. We introduce Structural Slow-Fast Learning, a mechanism utilizing causal attention to simultaneously process asynchronous visual and force tokens, allowing the policy to perform closed-loop adjustments at the force frequency while maintaining the temporal coherence of action chunks. Furthermore, to mitigate modality collapse where end-to-end models fail to adjust the weights across different modalities, we propose Virtual-target-based Representation Regularization. This auxiliary objective maps force feedback into the same space as the action, providing a stronger, physics-grounded learning signal than raw force prediction. Extensive experiments on contact-rich tasks demonstrate that ImplicitRDP significantly outperforms both vision-only and hierarchical baselines, achieving superior reactivity and success rates with a streamlined training pipeline. Code and videos will be publicly available at implicit-rdp.github.io.},
  archiveprefix = {arXiv},
  howpublished = {http://arxiv.org/abs/2512.10946},
  langid = {english},
  pubstate = {prepublished},
  keywords = {/unread},
  file = {C:\Users\guaoxiang\Zotero\storage\WAZ4RCIW\Chen 等 - 2025 - ImplicitRDP An End-to-End Visual-Force Diffusion Policy with Structural Slow-Fast Learning.pdf}
}

@misc{chenMaskedAutoencodersAre2025,
  title = {Masked {{Autoencoders Are Effective Tokenizers}} for {{Diffusion Models}}},
  author = {Chen, Hao and Han, Yujin and Chen, Fangyi and Li, Xiang and Wang, Yidong and Wang, Jindong and Wang, Ze and Liu, Zicheng and Zou, Difan and Raj, Bhiksha},
  year = 2025,
  month = may,
  number = {arXiv:2502.03444},
  eprint = {2502.03444},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2502.03444},
  urldate = {2025-09-20},
  abstract = {Recent advances in latent diffusion models have demonstrated their effectiveness for high-resolution image synthesis. However, the properties of the latent space from tokenizer for better learning and generation of diffusion models remain under-explored. Theoretically and empirically, we find that improved generation quality is closely tied to the latent distributions with better structure, such as the ones with fewer Gaussian Mixture modes and more discriminative features. Motivated by these insights, we propose MAETok, an autoencoder (AE) leveraging mask modeling to learn semantically rich latent space while maintaining reconstruction fidelity. Extensive experiments validate our analysis, demonstrating that the variational form of autoencoders is not necessary, and a discriminative latent space from AE alone enables state-of-the-art performance on ImageNet generation using only 128 tokens. MAETok achieves significant practical improvements, enabling a gFID of 1.69 with 76x faster training and 31x higher inference throughput for 512x512 generation. Our findings show that the structure of the latent space, rather than variational constraints, is crucial for effective diffusion models. Code and trained models are released.},
  archiveprefix = {arXiv},
  langid = {american},
  annotation = {TLDR: MAETok is proposed, an autoencoder (AE) leveraging mask modeling to learn semantically rich latent space while maintaining reconstruction fidelity and shows that the structure of the latent space, rather than variational constraints, is crucial for effective diffusion models.\\
abstractTranslation: 近期，潜在扩散模型（latent diffusion models）在高分辨率图像合成方面展现出卓越性能。然而，用于扩散模型学习与生成的分词器（tokenizer）所构建的潜在空间特性仍缺乏深入探索。从理论与实验两方面，我们发现生成质量的提升与具有更优结构的潜在分布密切相关，例如高斯混合模式（Gaussian Mixture modes）更少、判别性特征更显著的分布。受此启发，我们提出 MAETok------一种基于掩码建模（mask modeling）的自编码器（autoencoder, AE），旨在学习语义丰富的潜在空间，同时保持高保真重建能力。大量实验验证了我们的分析：变分形式的自编码器并非必需，仅使用普通自编码器所获得的判别性潜在空间，即可在 ImageNet 图像生成任务中仅用 128 个 token 实现当前最优性能。MAETok 在实际应用中带来显著提升：在 \$512\textbackslash times512\$ 分辨率图像生成任务中，其达到 \$1.69\$ 的 gFID，训练速度提升 \$76\$ 倍，推理吞吐量提高 \$31\$ 倍。我们的研究结果表明，潜在空间的结构特性，而非变分约束，才是构建高效扩散模型的关键。相关代码与训练模型已开源发布。\\
titleTranslation: 掩码自编码器可作为扩散模型的有效分词器},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\33QLDI4J\\Chen 等 - 2025 - Masked Autoencoders Are Effective Tokenizers for Diffusion Models.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\Z2882I98\\2502.03444v2.output.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\TNJAU2WB\\2502.html}
}

