@misc{lumCrossingHumanRobotEmbodiment2025,
  title = {Crossing the {{Human-Robot Embodiment Gap}} with {{Sim-to-Real RL}} Using {{One Human Demonstration}}},
  author = {Lum, Tyler Ga Wei and Lee, Olivia Y. and Liu, C. Karen and Bohg, Jeannette},
  year = 2025,
  month = aug,
  number = {arXiv:2504.12609},
  eprint = {2504.12609},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2504.12609},
  urldate = {2026-01-28},
  abstract = {Teaching robots dexterous manipulation skills often requires collecting hundreds of demonstrations using wearables or teleoperation, a process that is challenging to scale. Videos of human-object interactions are easier to collect and scale, but leveraging them directly for robot learning is difficult due to the lack of explicit action labels and human-robot embodiment differences. We propose Human2Sim2Robot, a novel real-to-sim-to-real framework for training dexterous manipulation policies using only one RGB-D video of a human demonstrating a task. Our method utilizes reinforcement learning (RL) in simulation to cross the embodiment gap without relying on wearables, teleoperation, or large-scale data collection. From the video, we extract: (1) the object pose trajectory to define an object-centric, embodiment-agnostic reward, and (2) the pre-manipulation hand pose to initialize and guide exploration during RL training. These components enable effective policy learning without any task-specific reward tuning. In the single human demo regime, Human2Sim2Robot outperforms object-aware replay by over 55\% and imitation learning by over 68\% on grasping, non-prehensile manipulation, and multi-step tasks. Website: https://human2sim2robot.github.io},
  archiveprefix = {arXiv},
  langid = {english},
  annotation = {TLDR: This work proposes Human2Sim2Robot, a novel real-to-sim-to-real framework for training dexterous manipulation policies using only one RGB-D video of a human demonstrating a task, which outperforms object-aware replay by over 55\% and imitation learning by over 68\% on grasping, non-prehensile manipulation, and multi-step tasks.\\
abstractTranslation: 训练机器人灵巧操作技能通常需要借助可穿戴设备或遥操作收集数百次演示，这一过程难以规模化。相比之下，人类与物体交互的视频更易于采集和扩展，但由于缺乏显式的动作标签以及人与机器人本体结构（embodiment）的差异，直接利用此类视频进行机器人学习仍具挑战性。为此，我们提出 Human2Sim2Robot------一种新颖的``真实{$\rightarrow$}仿真{$\rightarrow$}真实''（real-to-sim-to-real）框架，仅需一段人类执行任务的 RGB-D 视频即可训练灵巧操作策略。该方法在仿真环境中利用强化学习（reinforcement learning, RL）跨越本体差异，无需依赖可穿戴设备、遥操作或大规模数据采集。具体而言，我们从视频中提取：（1）物体位姿轨迹，用于构建以物体为中心且与本体无关（embodiment-agnostic）的奖励函数；（2）操作前的手部姿态，用于在 RL 训练中初始化并引导探索过程。上述组件使得策略学习无需任何任务特定的奖励函数调优即可高效进行。在仅使用单次人类演示的设定下，Human2Sim2Robot 在抓取、非抓握式操作及多步骤任务上的成功率分别比基于物体感知的回放（object-aware replay）方法高出 55\% 以上，比模仿学习（imitation learning）方法高出 68\% 以上。项目网站：https://human2sim2robot.github.io},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\6WHW7HNJ\\Lum 等 - 2025 - Crossing the Human-Robot Embodiment Gap with Sim-to-Real RL using One Human Demonstration.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\BMD746LL\\Lum 等 - 2025 - Crossing the Human-Robot Embodiment Gap with Sim-to-Real RL using One Human Demonstration.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\H932W4EW\\Lum 等 - 2025 - Crossing the Human-Robot Embodiment Gap with Sim-to-Real RL using One Human Demonstration.pdf}
}

