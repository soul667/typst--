@misc{shiFRMDFastRobot2025,
  title = {{{FRMD}}: {{Fast Robot Motion Diffusion}} with {{Consistency-Distilled Movement Primitives}} for {{Smooth Action Generation}}},
  shorttitle = {{{FRMD}}},
  author = {Shi, Xirui and Jin, Jun},
  year = 2025,
  month = mar,
  number = {arXiv:2503.02048},
  eprint = {2503.02048},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2503.02048},
  urldate = {2025-11-27},
  abstract = {我们研究了利用扩散模型生成快速、平滑且时间一致的机器人运动的问题。尽管扩散模型因其任务可扩展性和多模态灵活性在机器人学习中展现出卓越性能，但仍存在两个根本性局限：（1）由于难以捕捉时间上一致的运动动态，其生成的运动往往不够平滑、显得生硬；（2）其迭代采样过程在许多机器人任务中带来难以接受的延迟。受经典机器人运动生成方法（如DMPs和ProMPs）的启发------这些方法利用低维向量捕捉轨迹在时间和空间上的一致动态，同时也受到近期基于扩散的图像生成领域进展的启发------该领域利用一致性模型结合概率流常微分方程（ODE）加速去噪过程，我们提出了快速机器人运动扩散模型（Fast Robot Motion Diffusion, FRMD）。FRMD创新性地将运动基元（Movement Primitives, MPs）与一致性模型相结合，实现高效的单步轨迹生成。通过利用概率流ODE和一致性蒸馏，我们的方法在编码器-解码器架构中对轨迹分布进行建模，并学习紧凑且时间连续的运动表示。这一统一框架摒弃了传统扩散模型缓慢的多步去噪过程，实现了高效的单步推理和平滑的机器人运动生成。我们在广受认可的Meta-World和ManiSkill基准上对FRMD进行了全面评估，涵盖从简单到更复杂的操作任务，并与当前最先进的基线方法进行了对比。实验结果表明，FRMD不仅生成的轨迹显著更快、更平滑，而且取得了更高的任务成功率。 如果说 ManiCM 是想把 Diffusion 变快，那么 FRMD 就是觉得 ``快了容易手抖''，所以拉来了``老祖宗''帮忙。缝合方案： Consistency Model (新) + DMP (旧)。 DMP (Dynamic Movement Primitives): 这是 2000 年代 Schaal 等人提出的经典方法，特点就是数学上保证平滑，绝对不会让机械臂走出``帕金森''步伐。 FRMD 的做法： 既然 CM 生成的轨迹可能支离破碎，那我不是直接生成轨迹，而是用 CM 去生成 DMP 的参数（权重），再由 DMP 还原出轨迹。 效果： 强制平滑。},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {/},
  annotation = {TLDR: The results show that FRMD generates significantly faster, smoother trajectories while achieving higher success rates, and this unified approach eliminates the slow, multi-step denoising process of conventional diffusion models, enabling efficient one-step inference and smooth robot motion generation.\\
titleTranslation: FRMD：基于一致性蒸馏运动基元的快速机器人运动扩散模型，用于平滑动作生成},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\7CIZFIUS\\Shi和Jin - 2025 - FRMD Fast Robot Motion Diffusion with Consistency-Distilled Movement Primitives for Smooth Action G.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\B53RDZXM\\Shi和Jin - 2025 - FRMD Fast Robot Motion Diffusion with Consistency-Distilled Movement Primitives for Smooth Action G.pdf}
}

