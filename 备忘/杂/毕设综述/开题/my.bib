@misc{zengActiveUMIRoboticManipulation2025,
  title = {{{ActiveUMI}}: {{Robotic Manipulation}} with {{Active Perception}} from {{Robot-Free Human Demonstrations}}},
  shorttitle = {{{ActiveUMI}}},
  author = {Zeng, Qiyuan and Li, Chengmeng and John, Jude St and Zhou, Zhongyi and Wen, Junjie and Feng, Guorui and Zhu, Yichen and Xu, Yi},
  year = 2025,
  month = oct,
  number = {arXiv:2510.01607},
  eprint = {2510.01607},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2510.01607},
  urldate = {2026-01-17},
  abstract = {We present ActiveUMI, a framework for a data collection system that transfers in-the-wild human demonstrations to robots capable of complex bimanual manipulation. ActiveUMI couples a portable VR teleoperation kit with sensorized controllers that mirror the robot's end-effectors, bridging human-robot kinematics via precise pose alignment. To ensure mobility and data quality, we introduce several key techniques, including immersive 3D model rendering, a self-contained wearable computer, and efficient calibration methods. ActiveUMI's defining feature is its capture of active, egocentric perception. By recording an operator's deliberate head movements via a head-mounted display, our system learns the crucial link between visual attention and manipulation. We evaluate ActiveUMI on six challenging bimanual tasks. Policies trained exclusively on ActiveUMI data achieve an average success rate of 70\textbackslash\% on in-distribution tasks and demonstrate strong generalization, retaining a 56\textbackslash\% success rate when tested on novel objects and in new environments. Our results demonstrate that portable data collection systems, when coupled with learned active perception, provide an effective and scalable pathway toward creating generalizable and highly capable real-world robot policies.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {notion},
  annotation = {TLDR: The results demonstrate that portable data collection systems, when coupled with learned active perception, provide an effective and scalable pathway toward creating generalizable and highly capable real-world robot policies.\\
titleTranslation: ActiveUMI：基于无机器人参与的人类演示实现主动感知的机器人操作},
  file = {C\:\\Users\\guaoxiang\\Zotero\\storage\\BTNQ7AET\\Zeng 等 - 2025 - ActiveUMI Robotic Manipulation with Active Perception from Robot-Free Human Demonstrations.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\JE9Y7IVM\\Zeng 等 - 2025 - ActiveUMI Robotic Manipulation with Active Perception from Robot-Free Human Demonstrations_dual.pdf;C\:\\Users\\guaoxiang\\Zotero\\storage\\QLYPVV4C\\2510.html}
}

